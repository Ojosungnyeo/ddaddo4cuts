# Server-only. Never prefix these values with VITE_ and never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=photo-deliveries
PHOTO_TOKEN_PEPPER=replace_with_at_least_32_random_bytes
CRON_SECRET=replace_with_at_least_32_random_bytes

# Optional server-side limits (defaults shown).
PHOTO_MAX_BYTES=15728640
PHOTO_RATE_LIMIT_MAX=10
PHOTO_RATE_LIMIT_WINDOW_MINUTES=10

# Browser-safe Supabase values used only for signed uploads.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
